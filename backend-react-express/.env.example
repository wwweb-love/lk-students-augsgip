# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/test_db

# Секретный ключ для подписи JWT
JWT_SECRET=change_me

# Порт сервера (по умолчанию 3000)
PORT=3000

# Разрешённые источники CORS (через запятую)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Базовый адрес фронтенда (для ссылок в письмах о сбросе пароля)
FRONTEND_URL=http://localhost:5173

# SMTP для отправки почты.
# Если SMTP_HOST не задан — письма выводятся в консоль (DEV-режим).
# Пример для Яндекса: smtp.yandex.com, 465, пароль приложения
# SMTP_HOST=smtp.yandex.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-mail@yandex.ru
# SMTP_PASS=app-password
# SMTP_FROM=your-mail@yandex.ru
